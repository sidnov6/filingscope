# Copy to .env and replace both placeholders. Never commit real operator identity.
FILINGSCOPE_SEC_USER_AGENT="FilingScope/0.1 (YOUR_NAME; YOUR_EMAIL)"
FILINGSCOPE_DATA_DIR="./data"
FILINGSCOPE_LOG_LEVEL="INFO"
FILINGSCOPE_SEC_MIN_INTERVAL_SECONDS="0.2"
FILINGSCOPE_SEC_TIMEOUT_SECONDS="20"
FILINGSCOPE_SEC_CACHE_MAX_AGE_SECONDS="86400"

# Optional agent investigation. Deterministic analysis completes without these values.
FILINGSCOPE_GROQ_API_KEY=""
FILINGSCOPE_GROQ_REASONING_MODEL=""
FILINGSCOPE_INVESTIGATION_MAX_SIGNALS="8"
FILINGSCOPE_INVESTIGATION_MAX_EVIDENCE_PACKETS="12"
FILINGSCOPE_INVESTIGATION_MAX_RETRIES="1"
FILINGSCOPE_INVESTIGATION_WALL_CLOCK_SECONDS="180"
